# Copy to `.env` and fill in. `.env` is git- and docker-ignored – never commit it.
# Devcontainer: generated automatically (`python -m flighttracker.cli init-dev-env`).

# --- Database -----------------------------------------------------------------
# Used by docker-compose.yml to initialise PostgreSQL and build DATABASE_URL.
# Required. Use URL-safe characters only, e.g. generate with: openssl rand -hex 24
POSTGRES_USER=flighttracker
POSTGRES_DB=flighttracker
POSTGRES_PASSWORD=

# Only needed when running the app outside docker-compose.yml (e.g. devcontainer):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- Web / Auth ---------------------------------------------------------------
# Required. Session signing key, at least 32 characters: openssl rand -hex 32
SECRET_KEY=
ADMIN_USERNAME=admin
# Generate with: python -m flighttracker.cli hash-password
# (format scrypt:n:r:p:salt:hash – contains no `$`, safe for compose files)
ADMIN_PASSWORD_HASH=
# Set to false only for local http development.
SESSION_COOKIE_SECURE=true
# Host interface/port the web container is published on (keep 127.0.0.1 behind a reverse proxy).
WEB_BIND=127.0.0.1
WEB_PORT=8000
# Proxy addresses whose X-Forwarded-For is trusted, so the login lockout counts per real client.
# A reverse proxy on the Docker host reaches the container from the network's gateway, not
# from 127.0.0.1 – set it to: docker network inspect flighttracker_default \
#   --format '{{(index .IPAM.Config 0).Gateway}}'
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Flight data providers ----------------------------------------------------
# google_flights (real live fares, no account needed) | travelpayouts (needs token) | mock (fake data)
FLIGHT_PROVIDER=google_flights
# Only for FLIGHT_PROVIDER=travelpayouts: free token from https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
# Default monthly departure-date sampling for new Suchabos (adjustable per search: 4/8/15/31).
# Google Flights needs one request per departure day and stay length.
SCRAPER_DAYS_PER_MONTH=4
# Pause between scraper requests (seconds) to stay polite.
SCRAPER_REQUEST_DELAY_SECONDS=3

# --- Worker -------------------------------------------------------------------
WORKER_TICK_SECONDS=30
DEFAULT_POLL_INTERVAL_MINUTES=1440
MAX_ROUTE_PAIRS_PER_SEARCH=50
# Quota per user (admins have none): tracked searches + Trips, and provider requests per poll
# of all of them together. Both can also be changed under Settings → Platform Settings.
MAX_SEARCHES_PER_USER=10
MAX_REQUESTS_PER_USER=600
# Largest airports preselected when a whole country is entered (adjustable per Suchabo).
COUNTRY_DEFAULT_AIRPORTS=3
DEFAULT_CURRENCY=CHF
# Time zone for all timestamps shown in the UI (stored in UTC).
DISPLAY_TIMEZONE=Europe/Zurich

# --- Airport import -----------------------------------------------------------
# Your contact (URL or e-mail) for Wikidata, where passenger numbers for ranking airports
# by size come from. Wikimedia rejects requests without contact information; without it,
# airports are only sorted by type. Re-run the import after setting it:
#   python -m flighttracker.cli import-airports
WIKIDATA_CONTACT=
